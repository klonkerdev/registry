---@param title string
---@return boolean
function ImGui:IsWindowOpen(title) end

---Yields the current ModAPI-managed coroutine for a number of seconds.
---
---Do not call this from `EarlyInit`, which is not dispatched as a coroutine.
---@param seconds number
function wait(seconds) end

---Registers a callback for a known ModAPI event.
---@overload fun(name: "EarlyInit", callback: fun())
---@overload fun(name: "OnJoinGame", callback: fun())
---@overload fun(name: "IsInGame", callback: fun())
---@overload fun(name: "IsInMainMenu", callback: fun())
---@overload fun(name: "OnStationChanged", callback: fun(station_id: integer))
---@overload fun(name: "OnSystemChanged", callback: fun(system_id: integer))
---@overload fun(name: "OnMoneyChanged", callback: fun(money: integer))
---@overload fun(name: "OnEnemieKilled", callback: fun(count: integer))
---@overload fun(name: "OnCargoChanged", callback: fun(cargo: integer))
---@overload fun(name: "OnAsteroidDestroyed", callback: fun(count: integer))
---@overload fun(name: "OnStationDocked", callback: fun())
---@overload fun(name: "OnStationUndocked", callback: fun())
---@overload fun(name: "OnRadarScan", callback: fun(entity: KIPlayer))
---@overload fun(name: "OnUpdate", callback: fun())
---@param name GOF2EventName
---@param callback fun(...)
function RegisterEvent(name, callback) end

---Registers a callback around a known game function hook.
---@overload fun(name: "Globals::init", callback: fun(context: GlobalsInitContext))
---@overload fun(name: "AbyssEngine::PaintCanvas::SetColor", callback: fun(context: SetColorContext))
---@overload fun(name: "GameText::getText", callback: fun(context: GetTextContext))
---@overload fun(name: "ImageFactory::loadChar", callback: fun(context: LoadCharContext))
---@overload fun(name: "Level::createMission", callback: fun(context: MissionContext))
---@overload fun(name: "Level::createCampaignMission", callback: fun(context: MissionContext))
---@overload fun(name: "ModMainMenu::OnRender2D", callback: fun(context: Render2DContext))
---@overload fun(name: "MGame::OnRender2D", callback: fun(context: Render2DContext))
---@overload fun(name: "MenuTouchWindow::OnTouchEnd", callback: fun(context: TouchEndContext))
---@overload fun(name: "HangarWindow::render", callback: fun(context: ModStationWindowContext))
---@overload fun(name: "ModStation::OnRender2D", callback: fun(context: Render2DContext))
---@overload fun(name: "StatusWindow::draw", callback: fun(context: ModStationWindowContext))
---@param name GOF2HookName
---@param callback fun(context: HookContext)
function HookFunction(name, callback) end

---Registers an ImGui window while `init.lua` is loading.
---@param title string
---@param draw fun()
---@param toggle_key integer # Windows virtual-key code.
---@param lock_input boolean|integer # `true`/1 locks game input while open.
function RegisterWindow(title, draw, toggle_key, lock_input) end

