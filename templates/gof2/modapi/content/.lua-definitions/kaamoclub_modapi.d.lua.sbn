---@class System
---@field id integer
---@field name string
---@field risk integer
---@field faction integer
---@field jumpgatestationid integer
---@field mapcoordinate_x integer
---@field mapcoordinate_y integer
---@field mapcoordinate_z integer
---@field textureid integer
local System = {}

---Creates a system. Call only from the `EarlyInit` event.
---@param name string
---@param x integer
---@param y integer
---@param z integer
---@param faction integer
---@param risk integer
---@param texture_id integer
---@param linked_system_ids integer|integer[]
---@param jump_gate_station_id? integer
---@return integer system_id
function System:Create(
    name,
    x,
    y,
    z,
    faction,
    risk,
    texture_id,
    linked_system_ids,
    jump_gate_station_id)
    return 0
end

---@param system_id integer
---@return boolean
function System:IsVisible(system_id) end

---@param system_id integer
---@param visible boolean
function System:SetVisible(system_id, visible) end

---@param system_id integer
---@return System|nil
function System:Get(system_id) end

---@return integer[]
function System:GetStationsId() end

