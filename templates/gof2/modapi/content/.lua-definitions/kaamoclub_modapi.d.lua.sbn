---@meta

-- KaamoClubModApi Lua 5.4 definitions.
--
-- This file mirrors the public sol2 registrations in LuaManager::bind_api()
-- and the structured table fields read by the bound Game implementations.
-- It is editor metadata only and must never be required by a runtime mod.

---@alias GOF2EventName
---| "EarlyInit" # Fired once before custom content arrays are finalized.
---| "OnJoinGame" # Fired once when entering gameplay or a station.
---| "IsInGame" # Fired every update while in gameplay or a station.
---| "IsInMainMenu" # Fired every update while the main menu is active.
---| "OnStationChanged" # Receives the current station ID.
---| "OnSystemChanged" # Receives the current system ID.
---| "OnMoneyChanged" # Receives the current credit balance.
---| "OnEnemieKilled" # Receives the current enemy-kill count. The spelling is part of the API.
---| "OnCargoChanged" # Receives the current cargo amount.
---| "OnAsteroidDestroyed" # Receives the current destroyed-asteroid count.
---| "OnStationDocked" # Fired after docking.
---| "OnStationUndocked" # Fired after leaving a station for gameplay.
---| "OnRadarScan" # Receives the newly locked entity.
---| "OnUpdate" # Fired every update.

---@alias GOF2HookName
---| "Globals::init"
---| "AbyssEngine::PaintCanvas::SetColor"
---| "GameText::getText"
---| "ImageFactory::loadChar"
---| "Level::createMission"
---| "Level::createCampaignMission"
---| "ModMainMenu::OnRender2D"
---| "MGame::OnRender2D"
---| "MenuTouchWindow::OnTouchEnd"
---| "HangarWindow::render"
---| "ModStation::OnRender2D"
---| "StatusWindow::draw"

---@alias GOF2ItemType
---| "Laser"
---| "LaserBeam"
---| "Blaster"
---| "Booster"
---| "Cloak"
---| "Commodity"

---@class GOF2Vector3
---@field [1] number # X coordinate.
---@field [2] number # Y coordinate.
---@field [3] number # Z coordinate.

---@class GOF2Portrait
---@field race? integer
---@field hair? integer
---@field eyes? integer
---@field mouth? integer
---@field armor? integer

---@class GOF2PortraitTuple
---@field [1] integer # Race ID.
---@field [2] integer # Hair ID.
---@field [3] integer # Eyes ID.
---@field [4] integer # Mouth ID.
---@field [5] integer # Armor ID.

---@class GOF2DialogueEntry
---@field name string
---@field content string
---@field image GOF2PortraitTuple # Dialogue uses a positional five-value portrait.
---@field isplayer integer # 1 for the player speaker; 0 for another speaker.

---@class GOF2CutscenePoint
---@field pos GOF2Vector3
---@field duration number # Duration in seconds.
---@field shake? number
---@field shakefrequency? integer

---@class GOF2ShipInfo
---@field id? integer
---@field maxhealth? integer
---@field baseprice? integer
---@field maxcargo? integer
---@field cargo? integer
---@field price? integer
---@field controlmultiplier? number
---@field armor? integer
---@field bonuscargo? integer
---@field power? number

---@class GOF2EnginePoint
---@field pos GOF2Vector3
---@field intensity GOF2Vector3

---@class GOF2CustomShipInfo
---@field handling? number
---@field maxhealth? integer
---@field baseprice? integer
---@field maxcargo? integer
---@field armor? integer
---@field primaryslots? integer
---@field secondaryslots? integer
---@field turretslots? integer
---@field equipmentslots? integer
---@field hangar_y? number
---@field spriteicon? integer
---@field hasjumpdrive? boolean|integer
---@field enginecolor? integer
---@field primary_positions? GOF2Vector3[]
---@field secondary_positions? GOF2Vector3[]
---@field turret_positions? GOF2Vector3[]
---@field engines? GOF2EnginePoint[]

---@class GOF2HangarShipInfo
---@field id? integer
---@field price? integer

---@class GOF2AgentInfo
---@field talking_type? integer # 1 for a regular agent or 2 for a seller.
---@field talking_string? integer # Primary localized text ID.
---@field talking_string_2? integer # Secondary localized text ID for a seller.
---@field item_selling? integer
---@field item_count? integer
---@field item_price? integer
---@field auto_talking_string? boolean|integer

---@class GOF2ItemInfo
---@field type GOF2ItemType
---@field techlevel? integer
---@field baseprice? integer
---@field minprice? integer
---@field maxprice? integer
---@field spriteicon? integer
---@field damage? integer # Laser, LaserBeam, and Blaster.
---@field loadingspeed? integer # Weapons, Booster, and Cloak.
---@field range? integer # Laser, LaserBeam, and Blaster.
---@field speed? integer # Laser, LaserBeam, and Blaster.
---@field boostduration? integer # Booster.
---@field effect? integer # Booster and Cloak.
---@field energyconsumption? integer # Cloak.
---@field blueprint_ingredient_ids? integer[]
---@field blueprint_ingredient_counts? integer[]

---@class HookContext
local HookContext = {}

---Allows the wrapped game function to execute.
---
---Some after-render hooks and `Globals::init` do not require this call.
function HookContext:call() end

---@class MissionContext: HookContext
local MissionContext = {}

---Creates a fighter in the current mission level.
---@param mesh_id integer
---@param faction integer
---@return KIPlayer
function MissionContext:CreateFighter(mesh_id, faction) end

---Creates a supported static object in the current mission level.
---@param object_type integer # 0 for a pirate station; 1 for a Valkyrie turret.
---@param x number
---@param y number
---@param z number
---@return KIPlayer
function MissionContext:CreateStaticObject(object_type, x, y, z) end

---@class GlobalsInitContext: HookContext
local GlobalsInitContext = {}

---Creates a custom ship while `Globals::init` is running.
---@param name string
---@param description string
---@param ship_info GOF2CustomShipInfo
---@param diffuse_texture integer
---@param normal_texture integer
---@param material integer
---@param lod0_mesh integer
---@param lod1_mesh integer
---@param lod2_mesh integer
---@param mesh_lights? integer
---@param mesh_lights2? integer
---@return integer ship_id
function GlobalsInitContext:CreateShip(
    name,
    description,
    ship_info,
    diffuse_texture,
    normal_texture,
    material,
    lod0_mesh,
    lod1_mesh,
    lod2_mesh,
    mesh_lights,
    mesh_lights2)
    return 0
end

---Creates a game touch button.
---@param text string
---@param subtext string
---@param x integer
---@param y integer
---@param text_color integer
---@param state integer
---@param on_click fun()
---@return TouchButton
function GlobalsInitContext:CreateTouchButton(
    text,
    subtext,
    x,
    y,
    text_color,
    state,
    on_click)
    return {} ---@type TouchButton
end

---Creates a yes/no or acknowledgment choice window.
---@param title string
---@param description string
---@param show_buttons boolean
---@param on_yes fun()
---@param on_no fun()
---@return ChoiceWindow
function GlobalsInitContext:CreateChoiceWindow(
    title,
    description,
    show_buttons,
    on_yes,
    on_no)
    return {} ---@type ChoiceWindow
end

