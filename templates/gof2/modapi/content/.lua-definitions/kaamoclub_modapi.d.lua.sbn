mission = {
    id = 0,
    completedsidemissions = 0,
}

---@type Station
station = {
    id = 0,
    name = "",
    level = 0,
    hangaritemscount = 0,
    hangarshipscount = 0,
    agentscount = 0,
}

---@type Asset
asset = {}

---@type Item
item = {}

---@type Level
level = {}

---@type MemoryUtils
memoryutils = {}

---@type ImGui
imgui = {}

---@type Engine
engine = {}
